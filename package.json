{
  "name": "umi-starter",
  "version": "1.0.0",
  "private": true,
  "description": "业务无关的 Umi Max 基础框架",
  "author": "sfh <1769096110@qq.com>",
  "scripts": {
    "build": "max build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "dev": "max dev",
    "format": "prettier --write src mock .umirc.ts package.json typings.d.ts README.md",
    "format:check": "prettier --check src mock .umirc.ts package.json typings.d.ts README.md",
    "postinstall": "max setup",
    "lint": "max lint",
    "prepare": "husky",
    "setup": "max setup",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-9",
    "@umijs/max": "^4.7.32",
    "ahooks": "^3.11.0",
    "antd": "^6.7.0",
    "nprogress": "^0.2.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "husky": "^9",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "prettier-plugin-organize-imports": "^3.2.2",
    "prettier-plugin-packagejson": "^2.4.3",
    "typescript": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
